# Environment variables for mqs-molecule-generation
# Copy to .env and fill in if using hardware backends.
# No secrets in .env.example - only variable names.

# PennyLane / lightning.qubit: no credentials needed for local simulation

# IBM Quantum (hardware) - install extra: uv sync --extra hardware
# Get your token at: https://quantum.ibm.com/
# IBM_QUANTUM_TOKEN="YOUR_TOKEN_HERE"
# IBM_QUANTUM_CHANNEL="ibm_quantum_platform"
# IBM_QUANTUM_INSTANCE="ibm-q/open/main"

# IQM (hardware) - install extra: uv sync --extra hardware
# IQM_TOKEN="YOUR_TOKEN_HERE"
# IQM_SERVER_URL="https://cocos.resonance.meetiqm.com/v1"

# Moses (molecular benchmarking) - install extra: uv sync --extra moses
# MOSES_DATA_DIR="/path/to/moses/data"
